# ==========================================
# DocReader Environment Configuration
# ==========================================

# 1. PostgreSQL Settings (Used by Docker Compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=randompassword
POSTGRES_DB=docreader_db

# 2. Google Gemini API Key (Required for gemini-embedding-001 & gemini-2.5-flash)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here

# 3. Qdrant Vector Database
# Qdrant Cloud (Free 1GB cluster): https://cloud.qdrant.io/
QDRANT_URL=https://your-cluster-id.us-east-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-cloud-api-key
QDRANT_COLLECTION=doc_reader

# 4. Security & JWT Secrets
JWT_SECRET=super-secret-jwt-key-change-in-production
ADMIN_SECRET_KEY=admin-super-secret-key-12345
