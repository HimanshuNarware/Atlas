PORT=5000
NODE_ENV=development

# Database configuration (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/docreader_db
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=docreader_db
PGSSL=false

# Authentication
JWT_SECRET=super-secret-jwt-key-replace-in-production-minimum-32-chars
JWT_EXPIRES_IN=7d

# Admin secret key (optional dedicated header check for admin operations)
ADMIN_SECRET_KEY=admin-super-secret-key-12345

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# CORS Allowed Origins (comma separated)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Google Gemini API Key (@google/genai)
GEMINI_API_KEY=your-gemini-api-key-here

# Qdrant Vector Database (Remote / Qdrant Cloud or Local)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=docreader_documents
